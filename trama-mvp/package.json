{
  "name": "trama-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo": "next build && next start -p 3000",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "next build && playwright test --project=recorrido",
    "capturas": "next build && playwright test --project=capturas",
    "datos:generar": "node --experimental-strip-types --no-warnings scripts/datos/generar.ts",
    "datos:ingerir": "node --experimental-strip-types --no-warnings scripts/datos/ingerir.ts",
    "datos:evaluar": "node --experimental-strip-types --no-warnings scripts/datos/evaluar.ts",
    "datos:todo": "npm run datos:generar -- --escenario pitch --semilla 2026 && npm run datos:ingerir -- --escenario pitch && npm run datos:evaluar -- --escenario pitch"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
